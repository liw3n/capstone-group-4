DATABASE_URL=postgresql://postgres:testpassword@localhost:5432/pulse
# Local URL above stays local. Hosting: privately supply the Supabase session
# pooler URL (port 5432, database postgres) with sslmode=require in Render.
# Disable Supabase Data API first. See docs/deployment.md; never commit real URLs.
GROQ_API_KEY=replace-with-a-newly-generated-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
# Use a stable random value of at least 16 bytes outside local development.
PULSE_CAMPAIGN_PREVIEW_SECRET=replace-with-a-stable-random-preview-secret
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOOL_ROUNDS=5
LLM_HISTORY_LIMIT=50
EMAIL_DELIVERY_MODE=mock
# Live integration requires API-owner-confirmed URL, sender and authentication.
# GWM_EMAIL_BASE_URL=
# GWM_EMAIL_SEND_PATH=/EmailNotification/SendEmail
# GWM_EMAIL_SENDER=
# GWM_EMAIL_API_KEY=
# GWM_EMAIL_TIMEOUT_SECONDS=15
